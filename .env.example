MERAKI_BASE_URL=https://api.meraki.com/api/v1

# Environment
APP_ENV=development
LOG_LEVEL=INFO

# Ports
FRONTEND_PORT=43123
BACKEND_PORT=8000

# Topology refresh interval in seconds
TOPOLOGY_REFRESH_SECONDS=60

# Meraki Get Network Clients lookback (seconds). Cisco default is 1 day; max 31 days.
MERAKI_CLIENT_LOOKBACK_SECONDS=86400

# Network behavior
REQUEST_TIMEOUT_SECONDS=25
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2

# Storage path
DATA_DIR=./backend/data

# Security
SECRET_KEY=change_this_to_a_random_long_string

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:43123,http://127.0.0.1:43123,http://localhost:5500,http://127.0.0.1:5500

# Optional caching
CACHE_TTL_SECONDS=60
